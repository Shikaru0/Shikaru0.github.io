---
import { getModrinthProjects } from '../lib/modrinth';

const projects = await getModrinthProjects();

function formatNumber(num: number) {
  if (num >= 1000) return (num / 1000).toFixed(1) + 'k';
  return num.toString();
}
---

{projects.length > 0 && (
  <div class="repo-list">
    {projects.map((project) => (
      <a href={project.html_url} target="_blank" rel="noopener noreferrer" class="modrinth-card">
        {project.icon_url ? (
          <img src={project.icon_url} alt={project.title} class="modrinth-icon" />
        ) : (
          <div class="modrinth-icon-placeholder"></div>
        )}
        
        <div class="modrinth-info">
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          
          <div class="repo-meta">
            <span class="meta-item">⬇ {formatNumber(project.downloads)}</span>
            <span class="meta-item">❤ {formatNumber(project.followers)}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
)}